                   </property>
                  </widget>
                 </item>
                 <item row="0" column="1">
                  <widget class="QComboBox" name="cmbRtol">
                   <property name="toolTip">
                    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Define the acceptable error relative to the size of the state variable. The defaults value is set to 1e-3 (0.1% error).&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                   </property>
                   <property name="currentIndex">
                    <number>1</number>
                   </property>
                   <item>
                    <property name="text">
                     <string>1e-2 (Fast)</string>
                    </property>
                   </item>
                   <item>
                    <property name="text">
                     <string>1e-3 (Default)</string>
                    </property>
                   </item>
                   <item>
                    <property name="text">
                     <string>1e-4</string>
                    </property>
                   </item>
                   <item>
                    <property name="text">
                     <string>1e-5 (Strict)</string>
                    </property>
                   </item>
                  </widget>
                 </item>
                 <item row="1" column="0">
                  <widget class="QLabel" name="label_85">
                   <property name="text">
                    <string>Absolute Tolerance</string>
                   </property>
                  </widget>
                 </item>
                 <item row="1" column="1">
                  <widget class="QComboBox" name="cmbAtol">
                   <property name="toolTip">
                    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Define the acceptable error of the state variable. It is measured in the same units: Position in meters (m), Velocities in meters per second (m/s).&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                   </property>
                   <property name="currentIndex">
                    <number>2</number>
                   </property>
                   <item>
                    <property name="text">
                     <string>1e-4</string>
                    </property>
                   </item>
                   <item>
                    <property name="text">
                     <string>1e-5</string>
                    </property>
                   </item>
                   <item>
                    <property name="text">
                     <string>1e-6 (Default)</string>
                    </property>
                   </item>
                   <item>
                    <property name="text">
                     <string>1e-7</string>
                    </property>
                   </item>
                   <item>
                    <property name="text">
                     <string>1e-8</string>
                    </property>
                   </item>
                  </widget>
                 </item>
                 <item row="2" column="0">
                  <widget class="QLabel" name="label_86">
                   <property name="text">
                    <string>Max Step Limit</string>
                   </property>
                  </widget>
                 </item>
                 <item row="2" column="1">
                  <widget class="QComboBox" name="cmbMaxStep">
                   <property name="toolTip">
                    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Define the maximal Time interval (dt) during the simulation. The default value for Max Step in SciPy is Auto (no limit). It is recommended to limit the Time interval for Collision detection.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                   </property>
                   <item>
                    <property name="text">
                     <string>Auto (no limit)</string>
                    </property>
                   </item>
                   <item>
                    <property name="text">
                     <string>Bound to dt</string>
                    </property>
                   </item>
                   <item>
                    <property name="text">
                     <string>Bound to dt / 2</string>
                    </property>
                   </item>
                   <item>
                    <property name="text">
                     <string>Bound to dt / 10</string>
                    </property>
                   </item>
                  </widget>
                 </item>
                </layout>
               </item>
              </layout>
