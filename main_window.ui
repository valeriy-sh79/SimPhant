              </property>
             </widget>
            </item>
            <item>
             <widget class="QComboBox" name="cmbContactMesh">
              <property name="toolTip">
               <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Define the Contact processing method:&lt;/p&gt;&lt;p&gt;1) Standard Mesh: original CAD geometry of the contacted Bodies is considered.&lt;/p&gt;&lt;p&gt;2) Fine Mesh: the Body mesh is subdivided to increase the accuracy of the contact processing. Note: Simulation time is increased.&lt;/p&gt;&lt;p&gt;3) Proxy Meshes (Convex Hulls) is for CAD models with internal holes, chamfers. Generation of the &amp;quot;Convex Hull&amp;quot; (shrink-wrapping the geometry) reduces fine meshed model to lower vertices, speeding up the collision math.&lt;/p&gt;&lt;p&gt;4) Decimation (Simplification): If a Convex Hull is too simple (e.g., we need the teeth of a gear to collide), we can use mesh decimation instead of subdivision.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
              </property>
              <property name="currentIndex">
               <number>0</number>
              </property>
              <item>
               <property name="text">
                <string>Standard Mesh</string>
               </property>
              </item>
              <item>
               <property name="text">
                <string>Fine Mesh</string>
               </property>
              </item>
              <item>
               <property name="text">
                <string>Decimate Mesh</string>
               </property>
              </item>
              <item>
               <property name="text">
                <string>Convex Hull</string>
               </property>
              </item>
             </widget>
            </item>
