            </item>
            <item>
             <widget class="Line" name="line_15">
              <property name="orientation">
               <enum>Qt::Orientation::Horizontal</enum>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QFrame" name="frame_4">
              <property name="frameShape">
               <enum>QFrame::Shape::StyledPanel</enum>
              </property>
              <property name="frameShadow">
               <enum>QFrame::Shadow::Raised</enum>
              </property>
              <layout class="QVBoxLayout" name="verticalLayout_10">
               <item>
                <layout class="QGridLayout" name="gridLayout_5">
                 <item row="0" column="0">
                  <widget class="QLabel" name="label_27">
                   <property name="text">
                    <string>Solver Compliance (for over-constraint)</string>
                   </property>
                   <property name="wordWrap">
                    <bool>true</bool>
                   </property>
                  </widget>
                 </item>
                 <item row="0" column="1">
                  <widget class="QLabel" name="label_28">
                   <property name="text">
                    <string>Baumgarte Stabilization (for Joints): α,β</string>
                   </property>
                   <property name="wordWrap">
                    <bool>true</bool>
                   </property>
                  </widget>
                 </item>
                 <item row="1" column="0">
                  <widget class="QComboBox" name="cmbSolverCompliance">
                   <property name="toolTip">
                    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Consider Matrix (Tikhonov) Regularization) in case if the System is overconstrained.&lt;/p&gt;&lt;p&gt;The input value represents Constraint Compliance (m/N), the exact opposite of Stiffness. Mathematically, it acts like a virtual spring inserted into the Joint, which allows to share the load between the Joints.&lt;/p&gt;&lt;p&gt;Example of Usage:&lt;/p&gt;&lt;p&gt;0.0 (deactivated) means the Joint is infinitely stiff. It can be set for the properly constrained systems without Overconstraints.&lt;/p&gt;&lt;p&gt;1E-5 (soft) means the Joint is made of rubber or similar soft material.&lt;/p&gt;&lt;p&gt;1E-7 (default value) means the Joint is made of hard steel.&lt;/p&gt;&lt;p&gt;1E-9 (hard) or lower is for the simulations of the heavy rigid systems (massive train wheels) .&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                   </property>
                   <property name="currentIndex">
                    <number>2</number>
                   </property>
                   <item>
                    <property name="text">
                     <string>0 (Deactivated)</string>
                    </property>
                   </item>
                   <item>
                    <property name="text">
                     <string>1E-5 (Soft)</string>
                    </property>
                   </item>
                   <item>
                    <property name="text">
                     <string>1E-7 (Standard)</string>
                    </property>
                   </item>
                   <item>
                    <property name="text">
                     <string>1E-9 (Stiff)</string>
                    </property>
                   </item>
                   <item>
                    <property name="text">
                     <string>1E-11 (Ultra-Stiff)</string>
                    </property>
                   </item>
                  </widget>
                 </item>
                 <item row="1" column="1">
                  <widget class="QLineEdit" name="Edit_Alpha_Beta">
                   <property name="toolTip">
                    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;The Joint can physically drift apart due to numerical integration errors, and the Bodies can slowly disconnect from each other. Baumgarte stabilization pulls the Joints back together like a spring-damper system. &lt;/p&gt;&lt;p&gt;By default, the value is set to 20rad/s and can be modified as following:&lt;/p&gt;&lt;p&gt;Increase if the Joints are drifting too much;&lt;/p&gt;&lt;p&gt;If the simulation jitters or vibrates, then back the parameters down.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                   </property>
                   <property name="text">
                    <string>20</string>
                   </property>
                  </widget>
                 </item>
                </layout>
               </item>
              </layout>
             </widget>
            </item>
            <item>
             <widget class="QFrame" name="frmAdvancedSolver">
              <property name="frameShape">
               <enum>QFrame::Shape::StyledPanel</enum>
              </property>
              <property name="frameShadow">
               <enum>QFrame::Shadow::Raised</enum>
              </property>
              <layout class="QVBoxLayout" name="verticalLayout_9">
               <item>
                <layout class="QGridLayout" name="gridLayout_49">
