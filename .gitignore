# ==========================================
# SimPhant Git Ignore Rules
# ==========================================

# Local private versions & personal save files
--- Versions/
--- SaveFiles/
--- Demonstration/
--- Debug files/
___Obsolete/
*.mbd
!Examples/
!Examples/*.mbd
!Examples/**/*.mbd

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# PyInstaller & build outputs
dist/
build/
*.spec
*.manifest

# Application logs & CSV export directories
LogCSV/
*.log
debug_log.txt
results.csv
resultsgraf.csv

# Environments & IDE settings
.venv/
env/
venv/
ENV/
.vscode/
.idea/

# OS metadata
Thumbs.db
Desktop.ini
.DS_Store
*.lnk
